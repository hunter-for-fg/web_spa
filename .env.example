# Copy to .env.local and adapt as needed (.env.local is not committed).

# Development only: where the dev server proxies /api to. Default is the local Azure Functions host.
# VITE_API_PROXY_TARGET=https://hunter-rest-api.azurewebsites.net

# Build only: base URL of the REST API incl. the /api route prefix. Default is /api.
# VITE_API_BASE_URL=https://hunter-rest-api.azurewebsites.net/api
